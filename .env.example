# Copie este arquivo para ".env" e preencha os valores para rodar localmente.
# Em produção (Render), essas variáveis são definidas na aba "Environment" do serviço.

# OBRIGATÓRIA em produção. Gere uma com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Login do painel de usuários (/painel-usuarios/). Sem estas duas variáveis o painel fica desativado.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Usado apenas em produção (Render preenche automaticamente ao criar o PostgreSQL)
# DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco

# Usado em desenvolvimento local (MySQL) — instale com: pip install -r requirements-dev.txt
DB_NAME=restaurante_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
